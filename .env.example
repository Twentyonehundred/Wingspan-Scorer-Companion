# Copy to .env and fill in from Firebase console →
# Project settings → General → Your apps → Web app → SDK setup and configuration.
#
# Leave this file uncopied and the app still runs — it just keeps everything in
# the browser instead of syncing.
#
# These values are not secrets; a Firebase web config is public by design and
# access is controlled by the rules in firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
