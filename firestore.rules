rules_version = '2';

// Every document lives under the signed-in user's own subtree, and nobody can
// read or write anyone else's. Anonymous sessions count as signed in, so a
// visitor's sandbox is isolated the same way a real account is.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
